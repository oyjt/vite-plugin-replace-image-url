{
  "name": "vite-plugin-replace-image-url",
  "type": "module",
  "version": "2.0.0",
  "description": "A Vite plugin that replaces imported image URLs with external URLs at build time.",
  "license": "MIT",
  "author": "cnpath (https://github.com/oyjt)",
  "homepage": "https://github.com/oyjt/vite-plugin-replace-image-url",
  "repository": "https://github.com/oyjt/vite-plugin-replace-image-url.git",
  "keywords": [
    "vite-plugin",
    "vite",
    "url",
    "replace-image-url",
    "replace-url",
    "cdn-url"
  ],
  "files": [
    "dist",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/build.test.mjs"
  },
  "peerDependencies": {
    "vite": ">=3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.1.3",
    "unbuild": "^2.0.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
